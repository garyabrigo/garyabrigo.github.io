---
---

<canvas class="particles" aria-hidden="true" data-particles></canvas>

<script>
  (function () {
    const canvas = document.querySelector('[data-particles]') as HTMLCanvasElement;
    if (!canvas) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const conn = navigator.connection as any;
    const saveData = conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '');
    if (reduce.matches || saveData) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const FRAME_MS = 1000 / 30;
    const LINK_DIST_SQ = 100 * 100;
    const PARALLAX = 0.15;

    let width = 0;
    let height = 0;
    let particles: Array<{ x: number; y: number; vx: number; vy: number; r: number; color: string; alpha: number }> = [];
    let shiftY = 0;
    let rafId = 0;
    let lastDraw = 0;
    let hidden = false;
    let covered = false;

    function palette() {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      return dark ? ['#0E4F4F', '#3FA7A0', '#F2913F'] : ['#0E4F4F', '#3FA7A0', '#E8741E'];
    }

    function createParticles() {
      const colors = palette();
      const count = Math.min(Math.max(Math.floor((width * height) / 10000 * 0.5), 20), 45);
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          r: Math.random() * 1.5 + 0.5,
          color: colors[Math.floor(Math.random() * colors.length)],
          alpha: Math.random() * 0.4 + 0.2
        });
      }
    }

    // Backing store at 1x: these are sub-3px dots and hairlines, 2x only quadruples fill cost.
    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
      createParticles();
    }

    function draw(now: number) {
      rafId = 0;
      if (hidden || covered) return;
      rafId = requestAnimationFrame(draw);
      if (now - lastDraw < FRAME_MS) return;
      lastDraw = now;

      ctx!.clearRect(0, 0, width, height);
      const off = shiftY * PARALLAX;

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = width;
        else if (p.x > width) p.x = 0;
        if (p.y - off < 0) p.y = height + off;
        else if (p.y - off > height) p.y = off;

        ctx!.globalAlpha = p.alpha;
        ctx!.fillStyle = p.color;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y - off, p.r, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.lineWidth = 0.6;
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK_DIST_SQ) {
            ctx!.globalAlpha = (1 - d2 / LINK_DIST_SQ) * 0.12;
            ctx!.strokeStyle = a.color;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y - off);
            ctx!.lineTo(b.x, b.y - off);
            ctx!.stroke();
          }
        }
      }
      ctx!.globalAlpha = 1;
    }

    function sync() {
      if (!rafId && !hidden && !covered) rafId = requestAnimationFrame(draw);
    }

    resize();
    sync();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    }, { passive: true });

    window.addEventListener('scroll', () => { shiftY = window.scrollY; }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      hidden = document.hidden;
      sync();
    });

    // While the (opaque) hero fills the viewport the particles are invisible, so don't draw them.
    const hero = document.querySelector('.hero');
    if (hero) {
      const update = () => {
        const r = hero.getBoundingClientRect();
        covered = r.top <= 70 && r.bottom >= window.innerHeight - 2;
        sync();
      };
      new IntersectionObserver(update, { threshold: Array.from({ length: 21 }, (_, i) => i / 20) }).observe(hero);
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  })();
</script>

<style>
  .particles {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -3;
  }

  @media (prefers-reduced-motion: reduce) {
    .particles {
      display: none;
    }
  }
</style>
