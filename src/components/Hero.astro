---
import { personal, cvEnabled, type Lang } from '../lib/data';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero" aria-label={lang === 'es' ? 'Presentación' : 'Introduction'}>
  <div class="hero-bg" aria-hidden="true">
    <picture>
      <source media="(max-width: 700px) and (orientation: portrait)" srcset="/hero/hero-poster-mobile-540.webp" />
      <source media="(min-width: 1440px)" srcset="/hero/hero-poster-1920.webp" />
      <img
        class="hero-poster"
        src="/hero/hero-poster-1280.webp"
        alt=""
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
      data-hero-video
      hidden
    ></video>
  </div>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-greeting">{lang === 'es' ? 'Hola, soy' : 'Hi, I’m'}</p>
      <h1 class="hero-name" aria-label="Gary Abrigo">
        <span class="terminal-line" data-type-text="Gary Abrigo" aria-hidden="true"></span><span class="terminal-cursor" aria-hidden="true">|</span>
      </h1>
      <p class="hero-role">{lang === 'es' ? 'Analista de datos · Data Science' : 'Data Analyst · Data Science'}</p>
      <p class="hero-tagline">
        {lang === 'es'
          ? 'Convierto datos en decisiones: tableros con historia, modelos evaluados con honestidad.'
          : 'Turning data into decisions: dashboards with a story, models evaluated honestly.'}
      </p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">{lang === 'es' ? 'Ver proyectos' : 'View projects'}</a>
        {cvEnabled && (
          <a href={lang === 'es' ? '/cv/' : '/en/cv/'} class="btn btn-secondary">{lang === 'es' ? 'Descargar CV' : 'Download CV'}</a>
        )}
        <a href={personal.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={personal.linkedin} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="hero-chart" aria-hidden="true">
      <svg viewBox="0 0 400 200" class="chart-svg" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8AA4C8" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#8AA4C8" stop-opacity="0" />
          </linearGradient>
        </defs>
        <text x="20" y="30" class="chart-label" fill="#A1A1A1">Churn by age · proyecto 01</text>
        <g transform="translate(40, 40)">
          <line x1="0" y1="140" x2="340" y2="140" class="chart-axis" />
          <line x1="0" y1="140" x2="0" y2="0" class="chart-axis" />
          <text x="0" y="155" class="chart-tick" fill="#A1A1A1">18</text>
          <text x="80" y="155" class="chart-tick" fill="#A1A1A1">35</text>
          <text x="160" y="155" class="chart-tick" fill="#A1A1A1">50</text>
          <text x="240" y="155" class="chart-tick" fill="#A1A1A1">65</text>
          <text x="320" y="155" class="chart-tick" fill="#A1A1A1">80</text>
          <path d="M0,120 C40,115 60,100 90,90 S140,75 170,55 S220,10 250,8 S300,30 340,25" class="chart-line" fill="none" />
          <path d="M0,120 C40,115 60,100 90,90 S140,75 170,55 S220,10 250,8 S300,30 340,25 L340,140 L0,140 Z" class="chart-area" fill="url(#chartGradient)" />
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  (function () {
    const video = document.querySelector('[data-hero-video]') as HTMLVideoElement;
    const hero = video?.closest('.hero') as HTMLElement;
    const heroBg = hero?.querySelector('.hero-bg') as HTMLElement;
    if (!video || !hero || !heroBg) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const conn = navigator.connection as any;
    const saveData = conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '');

    if (reduce.matches || saveData) return;

    const w = window.innerWidth;
    const portrait = matchMedia('(orientation: portrait)').matches;
    // 720p is plenty for a dark abstract mesh and decodes far cheaper than 1080p (no HW decode on many Linux setups).
    const size = (w <= 700 && portrait) ? 'mobile-540' : '1280';

    video.poster = `/hero/hero-poster-${size}.webp`;
    for (const [ext, type] of [['webm', 'video/webm; codecs=vp9'], ['mp4', 'video/mp4']]) {
      const s = document.createElement('source');
      s.src = `/hero/hero-${size}.${ext}`;
      s.type = type;
      video.append(s);
    }
    video.hidden = false;
    video.preload = 'auto';
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.play().catch(() => {});

    new IntersectionObserver(([e]) => e.isIntersecting ? video.play().catch(() => {}) : video.pause()).observe(hero);

    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = Math.min(scrollY, hero.offsetHeight);
        heroBg.style.setProperty('--hero-shift', (y * 0.3).toFixed(1));
        ticking = false;
      });
    }, { passive: true });
  })();

  // Terminal typing effect for hero name
  (function () {
    const el = document.querySelector('[data-type-text]') as HTMLElement;
    const cursor = document.querySelector('.terminal-cursor') as HTMLElement;
    if (!el) return;
    const text = el.getAttribute('data-type-text') || '';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) {
      el.textContent = text;
      return;
    }
    el.textContent = '';
    let i = 0;
    function type() {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i++;
        setTimeout(type, i === 1 ? 400 : 60 + Math.random() * 80);
      } else if (cursor) {
        cursor.classList.add('terminal-cursor-blink');
      }
    }
    setTimeout(type, 600);
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: transparent;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    padding: 4rem 0;
    --hero-bg-h: 125vh;
    /* Hero is always dark, even in light theme */
    --hero-ink: #F2F2F2;
    --hero-muted: #A1A1A1;
    --hero-brand: #F2F2F2;
    --hero-accent: #F2F2F2;
    --hero-accent-text: #8AA4C8;
    --hero-chip-border: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 700px) {
    .hero {
      --hero-bg-h: 112vh;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    clip-path: inset(0);
  }

  .hero-poster,
  .hero-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--hero-bg-h);
    object-fit: cover;
    object-position: 50% 100%;
    pointer-events: none;
    transform: translate3d(0, calc(var(--hero-shift, 0) * -1px), 0);
  }

  .hero-video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 35vh;
    z-index: -1;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-greeting {
    color: var(--hero-accent-text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--hero-ink);
    font-family: var(--font-mono);
  }

  .terminal-line {
    font-family: var(--font-mono);
  }

  .terminal-line::before {
    content: '>';
    color: var(--hero-accent-text);
    margin-right: 0.35em;
  }

  .terminal-cursor {
    display: inline-block;
    color: var(--hero-accent-text);
    font-weight: 400;
    margin-left: 0.05em;
    opacity: 1;
  }

  .terminal-cursor-blink {
    animation: cursorBlink 1s step-end infinite;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor-blink {
      animation: none;
      opacity: 1;
    }
  }

  .hero-role {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--hero-muted);
    font-weight: 500;
    margin: 0 0 1.5rem;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--hero-muted);
    max-width: 540px;
    margin: 0 0 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Force dark-button look inside hero regardless of global theme */
  .hero .btn-primary {
    background: var(--hero-accent);
    color: #000000;
  }

  .hero .btn-secondary {
    background: transparent;
    color: var(--hero-ink);
    border-color: var(--hero-chip-border);
  }

  .hero .btn-secondary:hover,
  .hero .btn-secondary:focus {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--hero-brand);
  }

  .hero-chart {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .chart-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart-label {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .chart-axis {
    stroke: var(--hero-chip-border);
    stroke-width: 1;
  }

  .chart-tick {
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .chart-line {
    stroke: #8AA4C8;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: drawLine 2.5s ease-out forwards;
  }

  .chart-area {
    opacity: 0;
    animation: fadeArea 1s ease-out 1.5s forwards;
  }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fadeArea {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-poster,
    .hero-video {
      transform: none;
    }
    .chart-line {
      stroke-dashoffset: 0;
      animation: none;
    }
    .chart-area {
      opacity: 1;
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-chart {
      max-width: 360px;
    }
  }

  @media (max-width: 700px) {
    .hero-chart {
      display: none;
    }
  }
</style>
