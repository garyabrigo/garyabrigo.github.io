---
import { personal, meta, type Lang } from '../lib/data';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = meta[lang];
---

<section class="hero" aria-label={lang === 'es' ? 'Presentación' : 'Introduction'}>
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-greeting">{lang === 'es' ? 'Hola, soy' : 'Hi, I’m'}</p>
      <h1 class="hero-name">Gary Daniel Abrigo</h1>
      <p class="hero-role">{m.role}</p>
      <p class="hero-tagline">{m.valueLine}</p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">{m.ctaProjects}</a>
        <a href={lang === 'es' ? '/cv/' : '/en/cv/'} class="btn btn-secondary">{m.ctaCv}</a>
        <a href={personal.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={personal.linkedin} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="hero-chart" aria-hidden="true">
      <svg viewBox="0 0 400 200" class="chart-svg" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.25" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <text x="20" y="30" class="chart-label" fill="var(--muted)">Churn by age · proyecto 01</text>
        <g transform="translate(40, 40)">
          <line x1="0" y1="140" x2="340" y2="140" class="chart-axis" />
          <line x1="0" y1="140" x2="0" y2="0" class="chart-axis" />
          <text x="0" y="155" class="chart-tick" fill="var(--muted)">18</text>
          <text x="80" y="155" class="chart-tick" fill="var(--muted)">35</text>
          <text x="160" y="155" class="chart-tick" fill="var(--muted)">50</text>
          <text x="240" y="155" class="chart-tick" fill="var(--muted)">65</text>
          <text x="320" y="155" class="chart-tick" fill="var(--muted)">80</text>
          <path d="M0,120 C40,115 60,100 90,90 S140,75 170,55 S220,10 250,8 S300,30 340,25" class="chart-line" fill="none" />
          <path d="M0,120 C40,115 60,100 90,90 S140,75 170,55 S220,10 250,8 S300,30 340,25 L340,140 L0,140 Z" class="chart-area" fill="url(#chartGradient)" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    padding: 4rem 0;
    background: linear-gradient(180deg, var(--bg) 0%, rgba(14, 79, 79, 0.04) 100%);
  }

  [data-theme="dark"] .hero {
    background: linear-gradient(180deg, var(--bg) 0%, rgba(63, 167, 160, 0.04) 100%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-greeting {
    color: var(--accent-text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .hero-role {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 1.5rem;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--muted);
    max-width: 540px;
    margin: 0 0 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-chart {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .chart-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
  }

  .chart-axis {
    stroke: var(--chip-border);
    stroke-width: 1;
  }

  .chart-tick {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
  }

  .chart-line {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: drawLine 2.5s ease-out forwards;
  }

  .chart-area {
    opacity: 0;
    animation: fadeArea 1s ease-out 1.5s forwards;
  }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fadeArea {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-line {
      stroke-dashoffset: 0;
      animation: none;
    }
    .chart-area {
      opacity: 1;
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-chart {
      max-width: 360px;
    }
  }
</style>
