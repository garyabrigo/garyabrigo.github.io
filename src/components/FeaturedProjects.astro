---
import { getFeaturedProjects, t, categories, meta, type Lang, getTools } from '../lib/data';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const featured = getFeaturedProjects();
const m = meta[lang];
---

<section id="projects" class="section featured-section">
  <div class="container">
    <div class="section-header">
      <span class="section-number">01.</span>
      <h2 class="section-title">{lang === 'es' ? 'Proyectos destacados' : 'Featured projects'}</h2>
    </div>
    <div class="featured-list">
      {featured.map((project, index) => {
        const isEven = index % 2 === 0;
        return (
          <article class={`featured-card ${isEven ? 'featured-card-left' : 'featured-card-right'}`}>
            <div class="featured-image">
              {project.cover ? (
                <img
                  src={project.cover}
                  alt={`${t(project.title, lang)} — ${t(project.tagline, lang)}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  width="800"
                  height="500"
                />
              ) : (
                <div class="featured-typographic">
                  <span class="typographic-title">{t(project.title, lang)}</span>
                </div>
              )}
            </div>
            <div class="featured-content">
              <span class="featured-overline">{m.featuredOverline}</span>
              <h3 class="featured-title">
                <a href={`${lang === 'es' ? '/proyectos/' : '/en/projects/'}${project.id}/`}>{t(project.title, lang)}</a>
              </h3>
              <p class="featured-tagline">{t(project.tagline, lang)}</p>
              <p class="featured-description">{t(project.problem, lang)}</p>
              <ul class="featured-tech">
                {getTools(project).map(tool => (
                  <li>{tool}</li>
                ))}
              </ul>
              <div class="featured-links">
                <a href={`${lang === 'es' ? '/proyectos/' : '/en/projects/'}${project.id}/`} class="btn btn-secondary btn-sm">{m.viewProject}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .featured-section {
    background: var(--bg);
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    position: relative;
  }

  .featured-card-left .featured-image {
    order: 1;
  }
  .featured-card-left .featured-content {
    order: 2;
    text-align: right;
  }
  .featured-card-left .featured-tech,
  .featured-card-left .featured-links {
    justify-content: flex-end;
  }

  .featured-card-right .featured-image {
    order: 2;
  }
  .featured-card-right .featured-content {
    order: 1;
    text-align: left;
  }

  .featured-image {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 8px 30px var(--shadow);
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .featured-image:hover img,
  .featured-image:focus-within img {
    transform: scale(1.03);
  }

  .featured-typographic {
    aspect-ratio: 16/10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    background: linear-gradient(135deg, var(--surface) 0%, rgba(14, 79, 79, 0.06) 100%);
  }

  .typographic-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--brand);
    font-weight: 600;
  }

  .featured-content {
    padding: 1rem 0;
  }

  .featured-overline {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }

  .featured-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
  }

  .featured-title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-title a:hover,
  .featured-title a:focus {
    color: var(--accent-text);
  }

  .featured-tagline {
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .featured-description {
    background: var(--surface);
    padding: 1.25rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px var(--shadow);
    color: var(--muted);
    margin: 0 0 1.25rem;
  }

  .featured-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .featured-links {
    display: flex;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .featured-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .featured-card-left .featured-image,
    .featured-card-right .featured-image {
      order: 1;
    }
    .featured-card-left .featured-content,
    .featured-card-right .featured-content {
      order: 2;
      text-align: left;
    }
    .featured-card-left .featured-tech,
    .featured-card-left .featured-links {
      justify-content: flex-start;
    }
  }
</style>
