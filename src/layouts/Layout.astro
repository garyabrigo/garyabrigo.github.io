---
import '../styles/global.css';
import { getLanguagePath, personal, nav, siteUrl, type Lang } from '../lib/data';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { lang, title, description, path, ogImage = '/og-image.png' } = Astro.props;

const otherLang = lang === 'es' ? 'en' : 'es';
const otherPath = getLanguagePath(path, otherLang);
const canonical = siteUrl + path;
const alternate = siteUrl + otherPath;
const labels = nav[lang];
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={siteUrl + getLanguagePath(path, 'es')} />
    <link rel="alternate" hreflang="en" href={siteUrl + getLanguagePath(path, 'en')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_GT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={lang === 'es' ? '/' : '/en/'} class="logo" aria-label={lang === 'es' ? 'Inicio' : 'Home'}>
          <span class="logo-mark">d4nn<span class="logo-accent">ABR</span></span>
        </a>
        <nav class="main-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
          <ul>
            <li><a href={lang === 'es' ? '/#projects' : '/en/#projects'}>{labels.projects}</a></li>
            <li><a href={lang === 'es' ? '/#about' : '/en/#about'}>{labels.about}</a></li>
            <li><a href={lang === 'es' ? '/#contact' : '/en/#contact'}>{labels.contact}</a></li>
            <li><a href={lang === 'es' ? '/cv/' : '/en/cv/'}>{labels.cv}</a></li>
          </ul>
        </nav>
        <div class="header-actions">
          <a href={otherPath} class="lang-switch" lang={otherLang} aria-label={otherLang === 'es' ? 'Cambiar a español' : 'Switch to English'}>
            {otherLang.toUpperCase()}
          </a>
          <button class="theme-toggle" aria-label={lang === 'es' ? 'Cambiar tema' : 'Toggle theme'} type="button">
            <span class="theme-icon theme-icon-light" aria-hidden="true">☀</span>
            <span class="theme-icon theme-icon-dark" aria-hidden="true">☾</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-name">{personal.name}</p>
        <p class="footer-copy">
          {lang === 'es'
            ? '© 2026 — Analista de datos con base contable.'
            : '© 2026 — Data analyst with an accounting background.'}
        </p>
        <div class="footer-links">
          <a href={personal.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={personal.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={otherPath} lang={otherLang}>{otherLang === 'es' ? 'Español' : 'English'}</a>
        </div>
      </div>
    </footer>
    <script>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      const toggle = document.querySelector('.theme-toggle');
      const html = document.documentElement;
      toggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme') || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--chip-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    gap: 1rem;
  }

  .logo {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .logo-accent {
    color: var(--accent-text);
  }

  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .main-nav a:hover,
  .main-nav a:focus {
    color: var(--brand);
    text-decoration: underline;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switch {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--chip-border);
    border-radius: 4px;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
  }

  .lang-switch:hover,
  .lang-switch:focus {
    color: var(--brand);
    border-color: var(--brand);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 4px;
    border: 1px solid var(--chip-border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus {
    color: var(--brand);
    border-color: var(--brand);
  }

  [data-theme="dark"] .theme-icon-light,
  .theme-icon-dark {
    display: none;
  }

  [data-theme="dark"] .theme-icon-dark {
    display: inline;
  }

  .site-footer {
    border-top: 1px solid var(--chip-border);
    padding: 2.5rem 0;
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-name {
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .footer-copy {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover,
  .footer-links a:focus {
    color: var(--brand);
  }

  @media (max-width: 640px) {
    .main-nav {
      display: none;
    }
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
