---
import '../styles/global.css';
import Particles from '../components/Particles.astro';
import { getLanguagePath, personal, nav, siteUrl, cvEnabled, type Lang } from '../lib/data';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { lang, title, description, path, ogImage = '/og-image.png' } = Astro.props;

const otherLang = lang === 'es' ? 'en' : 'es';
const otherPath = getLanguagePath(path, otherLang);
const canonical = siteUrl + path;
const alternate = siteUrl + otherPath;
const labels = nav[lang];
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={siteUrl + getLanguagePath(path, 'es')} />
    <link rel="alternate" hreflang="en" href={siteUrl + getLanguagePath(path, 'en')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_GT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={lang === 'es' ? '/' : '/en/'} class="logo" aria-label={lang === 'es' ? 'Inicio' : 'Home'}>
          <span class="logo-mark">Gary <span class="logo-accent">Abrigo</span></span>
        </a>
        <nav class="main-nav" id="site-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
          <ul>
            <li><a href={lang === 'es' ? '/#projects' : '/en/#projects'}>{labels.projects}</a></li>
            <li><a href={lang === 'es' ? '/#about' : '/en/#about'}>{labels.about}</a></li>
            <li><a href={lang === 'es' ? '/#contact' : '/en/#contact'}>{labels.contact}</a></li>
            {cvEnabled && (
              <li><a href={lang === 'es' ? '/cv/' : '/en/cv/'}>{labels.cv}</a></li>
            )}
          </ul>
        </nav>
        <div class="header-actions">
          <a href={otherPath} class="lang-switch" lang={otherLang} aria-label={otherLang === 'es' ? 'Cambiar a español' : 'Switch to English'}>
            {otherLang.toUpperCase()}
          </a>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
          >
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-name">{personal.name}</p>
        <p class="footer-copy">
          {lang === 'es'
            ? '© 2026 — Analista de datos con base contable.'
            : '© 2026 — Data analyst with an accounting background.'}
        </p>
        <div class="footer-links">
          <a href={personal.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={personal.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          {cvEnabled && (
            <a href={lang === 'es' ? '/cv/' : '/en/cv/'}>{labels.cv}</a>
          )}
          <a href={otherPath} lang={otherLang}>{otherLang === 'es' ? 'Español' : 'English'}</a>
        </div>
      </div>
    </footer>
    <script>
      (function () {
        document.documentElement.classList.add('fonts-loading');
        if (document.fonts) {
          document.fonts.ready.then(function () {
            document.documentElement.classList.remove('fonts-loading');
          });
        }
      })();
    </script>
    <Particles />

    <script>
      // Cinematic scroll layer: skipped entirely (and never downloaded) for reduced motion / Save-Data.
      (function () {
        const conn = (navigator as any).connection;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData) return;
        import('../scripts/cinematic').then(m => m.init()).catch(() => {});
      })();
    </script>

    <script>
      (function () {
        const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
        const nav = document.getElementById('site-nav');
        if (!navToggle || !nav) return;

        function closeNav(returnFocus = false) {
          nav.classList.remove('nav-open');
          navToggle.setAttribute('aria-expanded', 'false');
          if (returnFocus) navToggle.focus();
        }

        function openNav() {
          nav.classList.add('nav-open');
          navToggle.setAttribute('aria-expanded', 'true');
          const firstLink = nav.querySelector('a') as HTMLElement | null;
          firstLink?.focus();
        }

        navToggle.addEventListener('click', () => {
          const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
          if (isOpen) closeNav();
          else openNav();
        });

        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) closeNav();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
            closeNav(true);
          }
        });

        const desktopQuery = window.matchMedia('(min-width: 641px)');
        desktopQuery.addEventListener('change', (e) => {
          if (e.matches) closeNav();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--chip-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-accent {
    color: var(--accent-text);
  }

  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .main-nav a:hover,
  .main-nav a:focus {
    color: var(--brand);
    text-decoration: underline;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--chip-border);
    border-radius: 4px;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
  }

  .lang-switch:hover,
  .lang-switch:focus {
    color: var(--brand);
    border-color: var(--brand);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--chip-border);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle-bar {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle-bar {
      transition: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--chip-border);
    padding: 2.5rem 0;
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-name {
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .footer-copy {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover,
  .footer-links a:focus {
    color: var(--brand);
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: flex;
    }

    .main-nav {
      display: none;
    }

    .main-nav.nav-open {
      display: block;
      position: fixed;
      top: calc(4rem + 1px);
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--chip-border);
      box-shadow: 0 12px 24px var(--shadow);
      z-index: 999;
    }

    .main-nav.nav-open ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.5rem 1rem;
    }

    .main-nav.nav-open li {
      border-bottom: 1px solid var(--chip-border);
    }

    .main-nav.nav-open li:last-child {
      border-bottom: none;
    }

    .main-nav.nav-open a {
      display: block;
      padding: 0.9rem 0;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
